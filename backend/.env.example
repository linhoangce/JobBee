# --- App ---
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Database ---
# Resolved relative to backend/ if not absolute.
DATABASE_URL=sqlite:///./data/jobbee.db

# --- LLM ---
# Provider: "openai" (any OpenAI-compatible endpoint) or "ollama".
LLM_PROVIDER=openai

# OpenRouter (recommended cloud setup — key + model only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Other OpenAI-compatible providers (when OPENROUTER_API_KEY is unset)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# AGENTROUTER_API_KEY=
# AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# For LLM_PROVIDER=ollama:
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.1

# Request defaults (seconds)
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=600
LLM_LONG_TIMEOUT_S=7200

# --- Apply vision (screenshot-guided browser navigation) ---
# Recommended for real ATS/company sites. Deterministic Playwright handles known
# flows first; when it stalls, a multimodal model reads screenshots + DOM summary
# and proposes the next safe action. Final submit is still never clicked.
APPLY_VISION_ENABLED=true
# Leave blank to use LLM_MODEL for Ollama / normal providers. For OpenRouter,
# blank uses the built-in vision default.
APPLY_VISION_MODEL=

# --- Email sync ---
# Fetch full job descriptions from posting URLs when inbox snippets are short.
# EMAIL_ENRICH_JD=false

# --- Gmail OAuth (INSTALLER ONLY — never shown to end users) ---
# Run once:  cd backend && .\.venv\Scripts\python.exe scripts\setup_gmail_oauth.py
# End users only click "Sign in with Google" in Settings.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/email/gmail/callback
# FRONTEND_URL=http://localhost:5173
